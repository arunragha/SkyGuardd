# ==============================================================================
# SkyGuard 7.0 — Root Environment Configuration Reference
# ==============================================================================

# Node.js API Gateway (backend/.env)
BACKEND_PORT=5000
NODE_ENV=development
JWT_SECRET=skyguard_v7_dev_secret_replace_in_production_with_high_entropy_key_64chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=false

# Python ML Microservice (ml-service)
ML_SERVICE_PORT=5001
ML_SERVICE_HOST=0.0.0.0
ML_WORKERS=1

# React Frontend (Vite)
VITE_API_URL=http://localhost:5000
VITE_SSE_URL=http://localhost:5000/api/telemetry/stream
