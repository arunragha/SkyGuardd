# ==============================================================================
# SkyGuard 7.0 — Backend Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Cryptographic Authentication Secrets (Mandatory in production)
# In production (NODE_ENV=production), server refuses to boot if JWT_SECRET is unset or default.
JWT_SECRET=skyguard_v7_dev_secret_replace_in_production_with_high_entropy_key_64chars
JWT_EXPIRES_IN=7d

# Microservice Integrations
ML_SERVICE_URL=http://localhost:5001

# Cross-Origin Resource Sharing (comma-separated whitelist)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Demonstration Mode (explicit flag, default false)
# When false: UI and backend operate on real telemetry and authentic ML predictions.
# When true: Dashboard shows a persistent top amber banner indicating synthetic sandbox mode.
DEMO_MODE=false
